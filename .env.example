# Copy this file to .env for local Docker development, then replace every
# CHANGE_ME value. Never use these example values in a public deployment.
APP_ENV=development

# Local MySQL container credentials
MYSQL_DATABASE=mauban_waste_collection
MYSQL_USER=mauban
MYSQL_PASSWORD=CHANGE_ME_local_mysql_password
MYSQL_ROOT_PASSWORD=CHANGE_ME_local_root_password

# Local administrator bootstrap account
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_Admin123

# Optional local developer account; leave blank to disable it
DEVELOPER_USERNAME=developer
DEVELOPER_PASSWORD=CHANGE_ME_Developer123

# Leave blank and register a collector through the website so the driver
# record is created and can be assigned to a truck and route by an admin.
COLLECTOR_USERNAME=
COLLECTOR_PASSWORD=

# Use 0 for local HTTP. Set to 1 when deployed behind HTTPS.
SESSION_COOKIE_SECURE=0
