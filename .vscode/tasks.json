{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start development (Docker Compose)",
            "type": "process",
            "command": "docker",
            "args": [
                "compose",
                "up",
                "--build",
                "-d"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "group": "build"
        },
        {
            "label": "Stop development (Docker Compose)",
            "type": "process",
            "command": "docker",
            "args": [
                "compose",
                "down"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
